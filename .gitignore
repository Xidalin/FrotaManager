# ==========================================
# 1. Dependências (Front e Back)
# ==========================================
node_modules/
.pnp/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# ==========================================
# 2. Variáveis de Ambiente (Segurança Máxima)
# ==========================================
# Bloqueia qualquer arquivo de ambiente, exceto os de exemplo
.env
.env.*
!.env.example
!.env.template

# ==========================================
# 3. Next.js / Frontend (Cache e Deploy)
# ==========================================
.next/
out/
.vercel/
.swc/
.turbo/
*.tsbuildinfo

# ==========================================
# 4. Node.js / Backend / TypeScript (Builds)
# ==========================================
dist/
build/
lib/
*.js.map

# ==========================================
# 5. Prisma / Banco de Dados Local
# ==========================================
# Ignora bancos locais caso você teste com SQLite antes do Postgres
*.db
*.db-journal
*.sqlite
*.sqlite3

# ==========================================
# 6. Logs de Erro e Debug
# ==========================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/

# ==========================================
# 7. Testes e Cobertura
# ==========================================
coverage/
.nyc_output/
.playwright/
test-results/

# ==========================================
# 8. Sistema Operacional e Editores (VS Code)
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ==========================================
# 9. Ferramentas de IA (Cursor, Claude, Devin, etc.)
# ==========================================
.agents/
.claude/
.cursor/
.devin/